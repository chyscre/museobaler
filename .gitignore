# Uploaded media. On a server these are shared directories that outlive a
# release (deploy.sh); the seeded exhibits' files come from
# database/seeders/media. QR labels are regenerated on demand.
/public/images/exhibits/*
/public/images/training/*
/public/images/qr/*
/public/images/branding/*
/public/audio/*
!/public/images/exhibits/.gitkeep
!/public/images/training/.gitkeep
!/public/images/qr/.gitkeep
!/public/images/branding/.gitkeep
!/public/audio/.gitkeep
