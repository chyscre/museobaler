APP_NAME=Laravel
APP_ENV=local
APP_TIMEZONE=Asia/Manila
APP_KEY=
# SECURITY: APP_DEBUG must be false in production — when true, unhandled
# errors render full stack traces (including file paths and query bindings)
# straight to the browser.
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
# Failed sign-ins, lockouts and role denials, on their own file.
# LOG_SECURITY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, not Laravel's sqlite default. The visitor API under public/api is
# raw PHP talking to this same database through mysqli, which cannot open a
# sqlite file - leave this on sqlite and you get an admin panel that works
# beside a visitor app that can read nothing.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=museobaler
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SECURITY: set SESSION_SECURE_COOKIE=true once the site is served over HTTPS
# in production, so the session cookie is never sent over plain HTTP.
SESSION_SECURE_COOKIE=false

# SECURITY: extra origins allowed to call the visitor API in public/api.
# Comma-separated, exact origins including the scheme, no trailing slash.
# Normally empty: the visitor PWA is served from the same host as the API, and
# same-origin requests are not subject to CORS at all. Fill this in only for a
# front end on a different origin, such as a native app wrapper. Anything not
# listed here (or same-origin) is refused - see public/api/_cors.php.
# API_ALLOWED_ORIGINS=https://museo.baler.gov.ph,capacitor://localhost

# The admin panel is laid out for a monitor. With this on (the default), a
# phone session can reach only the pages that genuinely need a phone —
# clocking in, which needs the camera, and setting your own password. Tablets
# are unaffected: the front desk register is meant to run on one. Turn it off
# only to debug the panel on a phone; it is a fit-for-purpose guard, never a
# security boundary.
# ADMIN_DESKTOP_ONLY=true

# Staff can only clock in from inside the geofence drawn around the museum's
# pin. Set this to false on a development machine that is nowhere near Baler
# so the scan can be tested; the attendance page shows a warning banner while
# it is off. Production ignores this setting entirely - the check always runs.
# ATTENDANCE_GEOFENCE=true

# The visitor app's own fence - the one that logs a visitor's entry and exit
# and shows the welcome toast. Same rule: set to false on a development
# machine to walk through the entry/exit flow from a desk; production ignores
# it. The phone used to decide this for itself from its hostname (localhost,
# any IP address, a tunnel domain), which would have switched the fence off
# for every visitor the day the app was served on the museum's LAN. Now the
# server answers through api/museum.php and the app obeys. A single device
# can still tighten the fence for a demo with ?geo=strict, never loosen it.
# VISITOR_GEOFENCE=true

# Seed data (php artisan db:seed) — set these to choose the initial staff
# login instead of letting the seeder generate and print a random one.
# Either way the seeded accounts start needing a password change: a password
# printed to a console or read out of this file is one more than one party has
# seen, so it survives exactly one sign-in.
# SEED_ADMIN_EMAIL=admin@museobaler.com
# SEED_ADMIN_PASSWORD=
# SEED_TOURISM_EMAIL=tourism@baler.gov.ph
# SEED_TOURISM_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google AI Studio key — translations and audio guides for new exhibits
GEMINI_API_KEY=

# Nightly database dumps (php artisan db:backup), written to
# storage/app/backups, each with a -media.tar.gz beside it holding the
# uploaded pictures and audio guides (folders listed in config/backup.php).
# The path is only needed where mysqldump is not on PATH,
# which includes Laragon and XAMPP — leave it blank and the command goes
# looking in the usual places.
# MYSQLDUMP_PATH="C:\laragon\bin\mysql\mysql-8.4.3-winx64\bin\mysqldump.exe"
# BACKUP_KEEP=14
#
# Encrypt every dump before it is written. `php artisan db:backup:key` prints
# a key; keep a copy somewhere that is not this machine, or the backups die
# with it. Without a key the dump is plain and the command warns every run.
# BACKUP_ENCRYPTION_KEY=
#
# A second copy of each dump, on a different disk - a second drive, a network
# share, a folder OneDrive or Google Drive syncs. Same retention applied.
# BACKUP_COPY_TO="D:\museobaler-backups"

# Who is emailed when something breaks: an unhandled error in production, a
# backup that failed, a backup that has not run in 36 hours. Sent through the
# MAIL_* settings above, so those need to be real on the server. Comma
# separated for more than one address.
# ALERT_EMAIL=tourism@baler.gov.ph
# ALERT_THROTTLE_MINUTES=30
# ALERT_BACKUP_MAX_AGE_HOURS=36
