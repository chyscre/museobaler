# SECURITY: no directory listings, unconditionally. Laravel's stock file
# wraps this in <IfModule mod_negotiation.c>, and on an Apache that does
# not load that module (Laragon's does not) the line silently never
# applies - every folder under public/ was an index page, including the
# recognition training photos and every exhibit picture by name.
Options -Indexes

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews
    </IfModule>

    RewriteEngine On

    # Exhibit media is served only by the signed API proxy. Leaving these
    # files directly addressable would bypass the visitor admission gate.
    RewriteRule ^(?:images/exhibits|audio)(?:/|$) - [R=404,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# The visitor app's service worker must reach phones the moment a release
# lands, so it is never held by an HTTP cache: the browser re-reads it on
# every navigation, sees the new VERSION, and installs the new release.
# Every other asset is cached by the worker itself, under a versioned name.
<Files "sw.js">
    Header set Cache-Control "no-cache, must-revalidate"
</Files>

# SECURITY: Prevent access to .env and other sensitive files if they end up in public/
<FilesMatch "(\.env|\.htpasswd|\.DS_Store)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# SECURITY: HTTP Strict Transport Security (HSTS)
#
# After one visit over HTTPS the browser refuses to speak plain HTTP to this
# host for a year, so the 301 above stops being something an attacker on the
# same wifi can get in front of.
#
# The expr= guard means this is sent only on a request that actually arrived
# over TLS. A browser is required to ignore HSTS received over plain HTTP,
# so this is belt and braces - but it also keeps the header out of the
# Laragon laptop, which serves this same file over http://yeppie.test.
#
# includeSubDomains covers every name under museodebaler.com. Nothing is
# served on a subdomain today; if that changes, the new one must have TLS
# from its first day or browsers that have seen this header will not open it
# at all. That is the intended effect, and it is the part of this line that
# is hard to take back: max-age is a year, and shortening it only helps
# browsers that come back to hear the new value.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# SECURITY: Additional security headers as a fallback (also set in PHP middleware)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # SAMEORIGIN, not DENY: third-party sites still cannot frame this app, but
    # DENY also blocked our own pages from embedding it — which is what
    # visitor/preview.html does to show the app at several device sizes at once.
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
