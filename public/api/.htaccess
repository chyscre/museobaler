Header always set ngrok-skip-browser-warning "true"

# SECURITY: CORS is decided per request in _cors.php, not here.
#
# These three lines used to set Access-Control-Allow-Origin "*" on every
# response. Because `always set` replaces whatever PHP had already sent, the
# allow-lists inside the endpoints were being overwritten and every response
# went out world-readable. Removing them is what lets those allow-lists work.

# SECURITY: Block direct browser access to the auth/db.php include file.
# This file is meant to be included by other PHP scripts only, not accessed via HTTP.
<Files "db.php">
    Order allow,deny
    Deny from all
</Files>
